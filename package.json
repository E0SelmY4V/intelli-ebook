{
	"$schema": "https://json.schemastore.org/package",
	"name": "intelli-ebook-js",
	"private": true,
	"version": "0.1.0",
	"description": "The js part of intelli-ebook",
	"author": "e0selmy4v",
	"devDependencies": {
		"@eslint/js": "latest",
		"@eslint/markdown": "latest",
		"@types/eslint": "latest",
		"@types/tape": "latest",
		"colortape": "latest",
		"eslint": "latest",
		"eslint-config-accurtype-style": "latest",
		"esm-entry": "latest",
		"globals": "latest",
		"husky": "latest",
		"prettier": "latest",
		"esbuild": "latest",
		"tsx": "latest",
		"rimraf": "latest",
		"tape": "latest",
		"typescript": "latest",
		"typescript-eslint": "latest"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/E0SelmY4V/intelli-ebook.git"
	},
	"scripts": {
		"prepare": "husky",
		"build": "pnpm run -r build",
		"clean": "pnpm run -r clean",
		"serve": "frankenphp php-server --listen=127.0.0.1:8889",
		"pretest": "tsc",
		"test": "pnpm run -r test",
		"prefmt": "prettier -w .",
		"fmt": "eslint . --fix",
		"prelint": "prettier -c .",
		"lint": "eslint .",
		"ci": "pnpm lint & pnpm test"
	},
	"prettier": {
		"printWidth": 200,
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"singleQuote": true,
		"jsxSingleQuote": false,
		"trailingComma": "all"
	}
}
